# Rego unit tests: scenarios.pharma_hospital.DEMO_CASES (and a few more)
# against the pharma_hospital data.
#
#   opa test policies/ -v
#
# policies/scenarios/pharma_hospital/data.json is regenerated by
# `python run_opa.py export`; loaded as a directory it sits under
# data.scenarios.pharma_hospital, so each test binds it to data.policy.
package stprbac.authz_test

import data.stprbac.authz

pharma := data.scenarios.pharma_hospital.policy

decide(q) := d if {
	d := authz.decision with input as q with data.policy as pharma
}

coordinator(q) := c if {
	c := authz.coordinator with input as q with data.policy as pharma
}

test_clinician_reads_ehr_for_care if {
	decide({"u": "alice", "r": "clinician", "o": "ehr", "p": "care", "l": "EU", "t": 50}).allow
}

test_coordinator_inherits_clinician_permission if {
	decide({"u": "erin", "r": "coordinator_role", "o": "ehr", "p": "care", "l": "EU", "t": 50}).allow
}

test_auditor_inactive_outside_phase_4 if {
	d := decide({"u": "dan", "r": "auditor", "o": "consent", "p": "audit", "l": "CH", "t": 150})
	not d.allow
	d.first_failure == "activation"
}

test_auditor_active_in_phase_4 if {
	decide({"u": "dan", "r": "auditor", "o": "consent", "p": "audit", "l": "CH", "t": 350}).allow
}

test_us_analyst_declaring_eu_locus if {
	decide({"u": "carol", "r": "analyst", "o": "genome", "p": "research", "l": "EU", "t": 150}).first_failure == "locus"
}

test_us_locus_cannot_reach_eu_governed_report if {
	decide({"u": "carol", "r": "analyst", "o": "report", "p": "reporting", "l": "US", "t": 250}).first_failure == "spatial"
}

test_data_manager_may_not_use_ehr_for_care if {
	d := decide({"u": "bob", "r": "data_manager", "o": "ehr", "p": "care", "l": "UK", "t": 50})
	d.first_failure == "purpose"
	d.conjuncts.minimisation
}

# The coordinator-to-analyst edge is only active in phases 2-3.
test_hierarchy_edge_expires if {
	q := {"u": "erin", "r": "analyst", "o": "labresults", "p": "research", "l": "UK"}
	decide(object.union(q, {"t": 150})).allow
	decide(object.union(q, {"t": 350})).first_failure == "activation"
}

# The coordinator phase is decided without the purpose.
test_coordinator_phase_without_purpose if {
	c := coordinator({"u": "bob", "r": "data_manager", "o": "ehr", "l": "UK", "t": 50})
	c.passed
	c.first_failure == null
}

test_batch_preserves_order if {
	qs := [
		{"u": "alice", "r": "clinician", "o": "ehr", "p": "care", "l": "EU", "t": 50},
		{"u": "dan", "r": "auditor", "o": "consent", "p": "audit", "l": "CH", "t": 150},
	]
	ds := authz.batch with input as {"requests": qs} with data.policy as pharma
	[d.allow | some d in ds] == [true, false]
}
